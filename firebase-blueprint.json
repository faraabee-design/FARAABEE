{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Herbal formulation or botanical wellness product",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "slug": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "urduName": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 100 },
        "price": { "type": "number" },
        "salePrice": { "type": "number" },
        "currency": { "type": "string", "maxLength": 20 },
        "volume": { "type": "string", "maxLength": 50 },
        "shortDescription": { "type": "string", "maxLength": 500 },
        "description": { "type": "string", "maxLength": 5000 },
        "image": { "type": "string", "maxLength": 2000000 },
        "secondaryImage": { "type": "string", "maxLength": 2000000 },
        "featured": { "type": "boolean" },
        "inStock": { "type": "boolean" },
        "stockQuantity": { "type": "number" },
        "sku": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["active", "draft", "archived"] },
        "displayOrder": { "type": "number" },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "number" },
        "traditionalUse": { "type": "string", "maxLength": 2000 },
        "directions": { "type": "string", "maxLength": 2000 },
        "precautions": { "type": "string", "maxLength": 2000 },
        "packagingInfo": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "category", "price", "currency", "shortDescription", "description", "status"]
    },
    "Category": {
      "title": "Category",
      "description": "Product taxonomy category",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "slug": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 500 },
        "displayOrder": { "type": "number" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "slug", "active"]
    },
    "Promotion": {
      "title": "Promotion",
      "description": "Featured marketing promotion or advertisement for a botanical product",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "productId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "subtitle": { "type": "string", "maxLength": 300 },
        "description": { "type": "string", "maxLength": 2000 },
        "discountPrice": { "type": "number" },
        "badge": { "type": "string", "maxLength": 50 },
        "image": { "type": "string", "maxLength": 2000000 },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["title", "description", "active"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 150 },
        "customerEmail": { "type": "string", "maxLength": 150 },
        "customerPhone": { "type": "string", "maxLength": 50 },
        "shippingAddress": { "type": "string", "maxLength": 500 },
        "city": { "type": "string", "maxLength": 100 },
        "notes": { "type": "string", "maxLength": 1000 },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "processing", "shipped", "delivered", "cancelled"] },
        "createdAt": { "type": "string" }
      },
      "required": ["customerName", "customerPhone", "shippingAddress", "total", "status"]
    },
    "Settings": {
      "title": "Settings",
      "description": "Store settings, contact details, and social media channels",
      "type": "object",
      "properties": {
        "x": { "type": "string", "maxLength": 500 },
        "youtube": { "type": "string", "maxLength": 500 },
        "tiktok": { "type": "string", "maxLength": 500 },
        "instagram": { "type": "string", "maxLength": 500 },
        "facebook": { "type": "string", "maxLength": 500 },
        "whatsapp": { "type": "string", "maxLength": 500 },
        "linkedin": { "type": "string", "maxLength": 500 },
        "pinterest": { "type": "string", "maxLength": 500 },
        "customPlatform": { "type": "string", "maxLength": 100 },
        "customUrl": { "type": "string", "maxLength": 500 },
        "email": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 50 },
        "whatsappDisplay": { "type": "string", "maxLength": 50 },
        "address": { "type": "string", "maxLength": 300 },
        "city": { "type": "string", "maxLength": 100 },
        "country": { "type": "string", "maxLength": 100 },
        "businessHours": { "type": "string", "maxLength": 200 },
        "updatedAt": { "type": "string" }
      }
    },
    "Admin": {
      "title": "Admin",
      "description": "Authorized administrator registry",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 150 },
        "role": { "type": "string", "enum": ["admin"] },
        "createdAt": { "type": "string" }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Collection of all herbal wellness products"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Collection of product categories"
    },
    "/promotions/{promotionId}": {
      "schema": "Promotion",
      "description": "Promotional banners and campaigns"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer orders submitted from checkout"
    },
    "/settings/{settingId}": {
      "schema": "Settings",
      "description": "Store configuration and social media touchpoints"
    },
    "/admins/{adminUid}": {
      "schema": "Admin",
      "description": "Authorized administrator registry"
    }
  }
}
